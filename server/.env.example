# إعدادات الخادم
PORT=3000
NODE_ENV=production

# مفتاح JWT السري (غيّره لقيمة عشوائية طويلة وآمنة)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# مدة صلاحية التوكن (بالساعات)
JWT_EXPIRES_IN=8

# إعدادات قاعدة البيانات
DB_PATH=./data/complaints.db

# إعدادات رفع الملفات
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# إعدادات CORS (عناوين الواجهة الأمامية المسموح بها)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# بيانات المسؤول الافتراضي (تُستخدم عند التثبيت الأول فقط)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=ChangeMe@2024!
DEFAULT_ADMIN_NAME=مدير النظام
