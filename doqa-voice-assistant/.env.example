# ===========================================
# مساعد دقة الصوتي الشخصي - متغيرات البيئة
# ===========================================
# انسخ هذا الملف إلى .env وأضف القيم الفعلية
# لا ترفع ملف .env إلى Git أبداً!

# --- إعدادات الخادم ---
PORT=3000
PUBLIC_BASE_URL=https://YOUR-DOMAIN.example
NODE_ENV=development

# --- المصادقة ---
APP_USERNAME=doqa
APP_PASSWORD=PUT-A-LONG-RANDOM-PASSWORD-HERE
SESSION_SECRET=PUT-ANOTHER-LONG-RANDOM-SECRET-HERE

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VOICE=alloy

# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VALIDATE_SIGNATURES=true

# --- إعدادات المكالمات ---
MAX_CALL_MINUTES=3
ALLOWED_DESTINATION_PREFIXES=+964
IRAQ_MOBILE_RATE_USD=0.4633

# --- وضع التشغيل ---
# demo = محاكاة بدون اتصال حقيقي
# live = اتصال حقيقي (يتطلب موافقة وتأكيد)
APP_MODE=demo
